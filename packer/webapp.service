[Unit]
Description=WebApp Service
After=network.target

[Service]
User=webapp
WorkingDirectory=/home/admin/webapp
ExecStart=/home/admin/webapp/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker main:app --bind 0.0.0.0:8000
Restart=always
Environment="POSTGRES_USER=csye6225"
Environment="POSTGRES_PASSWORD=csye6225"
Environment="POSTGRES_HOST=csye6225.example.us-east-1.rds.amazonaws.com"
Environment="POSTGRES_DB=csye6225"
Environment="S3_BUCKET=file-uploads-bucket"
Environment="AWS_REGION=us-east-1"

[Install]
WantedBy=multi-user.target